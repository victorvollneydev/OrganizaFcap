# ==========================================
# Configurações do Banco de Dados (PostgreSQL)
# ==========================================
# Em desenvolvimento local: postgresql://usuario:senha@localhost:5432/fcap_reservas
# Em produção (ex: Neon): postgresql://usuario:senha@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fcap_reservas

# ==========================================
# Chaves de Segurança da Aplicação Flask
# ==========================================
SECRET_KEY=sua-chave-secreta-flask-aqui
JWT_SECRET_KEY=sua-chave-secreta-jwt-aqui

# ==========================================
# Configurações de CORS e Frontend
# ==========================================
# Local: http://localhost:5173
# Produção (Vercel): https://seu-app-fcap.vercel.app
FRONTEND_URL=http://localhost:5173